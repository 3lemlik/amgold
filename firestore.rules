rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function isAdmin() { return signed() && request.auth.token.email == 'aligold@amnet.com'; }
    function lg() { return get(/databases/$(db)/documents/logins/$(request.auth.uid)).data; }
    function member() {
      return isAdmin() || (signed() && exists(/databases/$(db)/documents/logins/$(request.auth.uid))
        && lg().active == true && (lg().exp == null || lg().exp > request.time.toMillis()));
    }
    function chatOpen() {
      return !exists(/databases/$(db)/documents/config/public)
        || get(/databases/$(db)/documents/config/public).data.get('chatOpen', true) != false;
    }
    match /config/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /logins/{uid} { allow read: if isAdmin() || (signed() && request.auth.uid == uid); allow write: if isAdmin(); }
    match /posts/{id}   { allow read: if member(); allow write: if isAdmin(); }
    match /live/{id}    { allow read: if member(); allow write: if isAdmin(); }
    match /chat/{id} {
      allow read: if member();
      allow create: if member() && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000
        && (isAdmin() || chatOpen());
      allow delete: if isAdmin() || (signed() && resource.data.uid == request.auth.uid);
      allow update: if member() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
    }
    match /dm/{sid} {
      allow read, write: if isAdmin() || (signed() && request.auth.uid == sid && member());
      match /msgs/{id} {
        allow read: if isAdmin() || (signed() && request.auth.uid == sid && member());
        allow create: if (isAdmin() || (signed() && request.auth.uid == sid && member()))
          && request.resource.data.uid == request.auth.uid && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
        allow delete: if isAdmin() || (signed() && resource.data.uid == request.auth.uid);
        allow update: if (isAdmin() || (signed() && request.auth.uid == sid && member()))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
      }
    }
    match /users/{uid}/{rest=**} { allow read, write: if signed() && request.auth.uid == uid && member(); }
    match /logs/{id}    { allow read, write: if isAdmin(); }
  }
}
